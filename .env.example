# Postgres connection string (get one free from neon.tech or supabase.com)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign admin session JWTs — change this to a long random string
AUTH_SECRET="change-this-to-a-long-random-string"

# Public base URL used to build QR target links (no trailing slash)
# e.g. http://localhost:3000 in dev, or https://asal.example.com in production
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ASAL contact / social info shown on lifecycle pages and QR print sheet
NEXT_PUBLIC_ASAL_CONTACT_PHONE="+91 96298 85586"
NEXT_PUBLIC_ASAL_INSTAGRAM="https://www.instagram.com/p/DcFoDQdJWpT/"

# Seed admin account (used only by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@asal.com"
SEED_ADMIN_PASSWORD="asal0606"

# Razorpay — used for the ₹399/month subscription. Get these from
# Razorpay Dashboard → Settings → API Keys (Test Mode to start).
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_key_secret_here"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
